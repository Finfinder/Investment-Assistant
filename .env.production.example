# Investment Assistant — Production Environment Configuration
# Copy this file to backend/.env and update the values

# Application
APP_NAME=Investment Assistant
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database (SQLite for MVP — path relative to /app inside container)
DATABASE_URL=sqlite+aiosqlite:///./data/investment_assistant.db

# Data Provider API Keys (at least yfinance works without keys)
TWELVE_DATA_API_KEY=
FMP_API_KEY=
CURRENCYLAYER_API_KEY=
MARKETSTACK_API_KEY=
FRED_API_KEY=

# Cache TTL (seconds)
CACHE_TTL_INTRADAY=300
CACHE_TTL_DAILY=3600

# CORS (restrict to your domain in production)
CORS_ORIGINS=["http://localhost"]
