# Investment Assistant - Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=Investment Assistant
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=DEBUG

# Database (SQLite for MVP)
DATABASE_URL=sqlite+aiosqlite:///./data/investment_assistant.db

# Data Provider API Keys
TWELVE_DATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

# Cache TTL (seconds)
CACHE_TTL_INTRADAY=300
CACHE_TTL_DAILY=3600

# Redis Cache
# For local development (Redis on host):
# REDIS_URL=redis://localhost:6379/0
# For Docker deployment (Redis in container):
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
# Optional: override CACHE_TTL_INTRADAY/DAILY for all cache entries
# REDIS_CACHE_TTL_OVERRIDE=600

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]
